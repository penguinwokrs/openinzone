<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenInzone.Tests</RootNamespace>
    <AssemblyName>OpenInzone.Core.Tests</AssemblyName>
    <Copyright>Copyright (C) 2026 penguinwokrs</Copyright>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      OpenInzone.Core is marked windows-only as a whole because most of it is P/Invoke and COM.
      The protocol layer under test is plain managed code with no platform calls in it, so these
      tests build and run anywhere, including the WSL side of a Windows development machine.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenInzone.Core\OpenInzone.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenInzone.Control\OpenInzone.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenInzone.Cli\OpenInzone.Cli.csproj" />
  </ItemGroup>
</Project>
