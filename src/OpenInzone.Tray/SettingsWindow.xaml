<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenInzone.Tray.SettingsWindow"
        Title="OpenInzone の設定" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF202225">
  <StackPanel Margin="20">
    <TextBlock Text="ショートカット" FontSize="15" Foreground="#FFE8EAED" Margin="0,0,0,4" />
    <TextBlock Text="行を選んでキーの組み合わせを押すと割り当てます。Esc で解除。"
               Foreground="#FF9AA0A6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

    <ItemsControl x:Name="Rows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DisplayName}" Foreground="#FFE8EAED" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding Display}" Tag="{Binding Id}"
                    Click="OnCaptureClick" Height="28"
                    Foreground="{Binding Brush}" Background="#FF2A2D31" BorderBrush="#FF3A3D42" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <CheckBox x:Name="AutostartBox" Content="Windows の起動時に常駐する"
              Foreground="#FFE8EAED" Margin="0,16,0,0" />
    <CheckBox x:Name="CheckUpdatesBox" Content="起動時に更新を確認する"
              Foreground="#FFE8EAED" Margin="0,6,0,0" />

    <TextBlock x:Name="VersionText" Foreground="#FF9AA0A6" FontSize="12" Margin="0,16,0,8" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="UpdateButton" Content="更新を確認" Click="OnUpdateClick" Width="140" Height="28" />
      <TextBlock x:Name="UpdateStatusText" Foreground="#FF9AA0A6" FontSize="12"
                 VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="既定に戻す" Click="OnResetClick" Width="110" Height="30" Margin="0,0,8,0" />
      <Button Content="保存" Click="OnSaveClick" Width="90" Height="30" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
