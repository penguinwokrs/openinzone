<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenInzone.Tray.SettingsWindow"
        Title="OpenInzone の設定" Width="560" Height="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF202225">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="Quiet" Color="#FF9AA0A6" />
    <SolidColorBrush x:Key="Panel" Color="#FF26292D" />
    <SolidColorBrush x:Key="Line" Color="#FF3A3D42" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#FF2F3237" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <!-- The stock tab strip is light grey chrome; this is the same dark surface as the rest. -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Quiet}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" BorderThickness="0,0,0,2"
                    BorderBrush="Transparent" Padding="16,8" Margin="0,0,4,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4C9AFF" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2A2D31" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl Margin="14" Background="Transparent" BorderThickness="0">
    <TabControl.Resources>
      <Style TargetType="TabPanel">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
    </TabControl.Resources>

    <TabItem Header="全般">
      <StackPanel Margin="6,14,6,0">
        <CheckBox x:Name="AutostartBox" Content="Windows の起動時に常駐する"
                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="24,4,0,0"
                   Text="ログイン時にトレイアイコンを出します。" />

        <CheckBox x:Name="CheckUpdatesBox" Content="起動時に更新を確認する" Margin="0,16,0,0"
                  Checked="OnCheckUpdatesChanged" Unchecked="OnCheckUpdatesChanged" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="24,4,0,0"
                   Text="GitHub のリリースを見に行きます。失敗しても何も表示しません。" />

        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="0,24,0,0"
                   Text="変更はその場で反映されます。保存する操作はありません。" />
      </StackPanel>
    </TabItem>

    <TabItem Header="ホットキー">
      <DockPanel Margin="6,10,6,0">
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,0,0,10"
                   Text="行を押してからキーの組み合わせを押すと割り当てます。Esc で解除。" />
        <Button DockPanel.Dock="Bottom" Content="既定に戻す" Click="OnResetClick"
                HorizontalAlignment="Left" Margin="0,10,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding Display}" Tag="{Binding Id}"
                          Click="OnCaptureClick" Height="28" Padding="8,0"
                          Foreground="{Binding Brush}" Background="#FF2A2D31" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

    <TabItem Header="アップデート">
      <StackPanel Margin="6,14,6,0">
        <TextBlock x:Name="VersionText" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button x:Name="UpdateButton" Content="更新を確認" Click="OnUpdateClick" Width="150" />
        </StackPanel>
        <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,12,0,0" />
      </StackPanel>
    </TabItem>

    <TabItem Header="プラグイン">
      <StackPanel Margin="6,14,6,0">
        <TextBlock Text="Stream Deck プラグイン" FontSize="14" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="0,6,0,0"
                   Text="ヘッドセットの音量・バランス・マイク・バッテリーを Stream Deck のキーから操作できます。取り込んだあとは、このアプリを開いていなくても動きます。" />

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button x:Name="PluginDownloadButton" Content="ダウンロード" Click="OnPluginDownloadClick"
                  Width="150" />
          <Button x:Name="PluginOpenButton" Content="Stream Deck に取り込む" Click="OnPluginOpenClick"
                  Margin="8,0,0,0" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="PluginStatusText" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,12,0,0" />

        <TextBlock Margin="0,16,0,0" FontSize="12">
          <Hyperlink Click="OnReleasesClick" Foreground="#FF4C9AFF">
            リリースページを開く
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
