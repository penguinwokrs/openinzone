<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OpenInzone.Resources;assembly=OpenInzone.Resources"
        x:Class="OpenInzone.Tray.SettingsWindow"
        Title="{x:Static res:Strings.Settings_Title}" Width="560" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF202225">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="Quiet" Color="#FF9AA0A6" />
    <SolidColorBrush x:Key="Panel" Color="#FF26292D" />
    <SolidColorBrush x:Key="Line" Color="#FF3A3D42" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#FF2F3237" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <!-- The stock combo is light grey chrome, like the tab strip below it. Only the closed box is
         restyled: the drop-down list is drawn by the system and left alone. -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Quiet}" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,26,0"
                                VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Slide">
                <Border Background="#FF2A2D31" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}">
                  <StackPanel IsItemsHost="True" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF3A3D42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The stock tab strip is light grey chrome; this is the same dark surface as the rest. -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Quiet}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" BorderThickness="0,0,0,2"
                    BorderBrush="Transparent" Padding="16,8" Margin="0,0,4,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4C9AFF" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2A2D31" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl Margin="14" Background="Transparent" BorderThickness="0">
    <TabControl.Resources>
      <Style TargetType="TabPanel">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
    </TabControl.Resources>

    <TabItem Header="{x:Static res:Strings.Settings_Tab_General}">
      <StackPanel Margin="6,14,6,0">
        <CheckBox x:Name="AutostartBox" Content="{x:Static res:Strings.Settings_Autostart}"
                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="24,4,0,0"
                   Text="{x:Static res:Strings.Settings_AutostartHint}" />

        <CheckBox x:Name="CheckUpdatesBox" Content="{x:Static res:Strings.Settings_CheckUpdates}" Margin="0,16,0,0"
                  Checked="OnCheckUpdatesChanged" Unchecked="OnCheckUpdatesChanged" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="24,4,0,0"
                   Text="{x:Static res:Strings.Settings_CheckUpdatesHint}" />

        <TextBlock Text="{x:Static res:Strings.Settings_UiLanguage}" FontSize="13" Margin="0,20,0,0" />
        <ComboBox x:Name="UiLanguageBox" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"
                  SelectionChanged="OnUiLanguageChanged">
          <!-- Each language named in its own script on purpose: somebody looking at a window they
               cannot read needs to find their language without knowing its English name first.
               These are not resources for the same reason - they must not change with the UI. -->
          <ComboBoxItem Content="English" Tag="en" />
          <ComboBoxItem Content="日本語" Tag="ja" />
          <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
        </ComboBox>
        <TextBlock Text="{x:Static res:Strings.Settings_UiLanguageHint}" FontSize="11"
                   Foreground="{StaticResource Quiet}" Margin="0,6,0,0" />

        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="0,24,0,0"
                   Text="{x:Static res:Strings.Settings_AppliedImmediatelyHint}" />
      </StackPanel>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.Settings_Tab_Device}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DevicePanel" Margin="6,12,14,0" IsEnabled="False">
          <TextBlock x:Name="DeviceStatusText" Foreground="{StaticResource Quiet}" FontSize="12"
                     Margin="0,0,0,12" Text="{x:Static res:Strings.Settings_DeviceQuerying}" />

          <TextBlock Text="{x:Static res:Strings.Settings_Ambient}" FontSize="13" />
          <StackPanel x:Name="AmbientGroup" Margin="0,8,0,0">
            <RadioButton x:Name="AmbientOffButton" GroupName="Ambient" Content="{x:Static res:Strings.Settings_AmbientOff}"
                         Foreground="{StaticResource Text}" Tag="0" />
            <RadioButton x:Name="NoiseCancellingButton" GroupName="Ambient" Content="{x:Static res:Strings.Settings_NoiseCancelling}"
                         Foreground="{StaticResource Text}" Margin="0,6,0,0" Tag="1" />
            <RadioButton x:Name="AmbientButton" GroupName="Ambient" Content="{x:Static res:Strings.Settings_AmbientOn}"
                         Foreground="{StaticResource Text}" Margin="0,6,0,0" Tag="2" />

            <Grid x:Name="AmbientLevelRow" Margin="22,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static res:Strings.Settings_AmbientLevel}" FontSize="12" VerticalAlignment="Center"
                         Foreground="{StaticResource Quiet}" />
              <Slider x:Name="AmbientLevelSlider" Grid.Column="1" Minimum="1" Maximum="20"
                      IsSnapToTickEnabled="True" TickFrequency="1" Margin="10,0"
                      VerticalAlignment="Center" />
              <TextBlock x:Name="AmbientLevelText" Grid.Column="2" FontSize="12"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <CheckBox x:Name="VoiceFocusBox" Content="{x:Static res:Strings.Settings_VoiceFocus}" Margin="22,10,0,0" />
          </StackPanel>

          <TextBlock Text="{x:Static res:Strings.Settings_Sidetone}" FontSize="13" Margin="0,20,0,0" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="SidetoneSlider" Minimum="0" Maximum="10" IsSnapToTickEnabled="True"
                    TickFrequency="1" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="SidetoneText" Grid.Column="1" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="{x:Static res:Strings.Settings_Other}" FontSize="13" Margin="0,20,0,0" />
          <CheckBox x:Name="AutoPowerOffBox" Content="{x:Static res:Strings.Settings_AutoPowerOff}" Margin="0,8,0,0" />
          <CheckBox x:Name="BluetoothAutoSwitchBox" Margin="0,8,0,0"
                    Content="{x:Static res:Strings.Settings_BluetoothSwitch}" />
          <CheckBox x:Name="VoiceGuidanceBox" Content="{x:Static res:Strings.Settings_VoiceGuidance}" Margin="0,8,0,0" />
          <StackPanel x:Name="LanguageRow" Orientation="Horizontal" Margin="22,8,0,14">
            <TextBlock Text="{x:Static res:Strings.Settings_VoiceGuidanceLanguage}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource Quiet}" />
            <ComboBox x:Name="LanguageBox" Width="130" Margin="10,0,0,0" Height="26">
              <ComboBoxItem Content="{x:Static res:Strings.Settings_VoiceLanguage_English}" Tag="0" />
              <ComboBoxItem Content="{x:Static res:Strings.Settings_VoiceLanguage_Japanese}" Tag="1" />
              <ComboBoxItem Content="{x:Static res:Strings.Settings_VoiceLanguage_Chinese}" Tag="2" />
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.Settings_Tab_Hotkeys}">
      <DockPanel Margin="6,10,6,0">
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,0,0,10"
                   Text="{x:Static res:Strings.Settings_HotkeyHint}" />
        <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.Settings_ResetDefaults}" Click="OnResetClick"
                HorizontalAlignment="Left" Margin="0,10,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding Display}" Tag="{Binding Id}"
                          Click="OnCaptureClick" Height="28" Padding="8,0"
                          Foreground="{Binding Brush}" Background="#FF2A2D31" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.Settings_Tab_Update}">
      <StackPanel Margin="6,14,6,0">
        <TextBlock x:Name="VersionText" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button x:Name="UpdateButton" Content="{x:Static res:Strings.Settings_CheckNow}" Click="OnUpdateClick" Width="150" />
        </StackPanel>
        <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,12,0,0" />
      </StackPanel>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.Settings_Tab_Plugin}">
      <StackPanel Margin="6,14,6,0">
        <TextBlock Text="{x:Static res:Strings.Settings_StreamDeckPlugin}" FontSize="14" />
        <TextBlock Foreground="{StaticResource Quiet}" FontSize="12" Margin="0,6,0,0"
                   Text="{x:Static res:Strings.Settings_PluginDescription}" />

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button x:Name="PluginDownloadButton" Content="{x:Static res:Strings.Settings_PluginDownload}" Click="OnPluginDownloadClick"
                  Width="150" />
          <Button x:Name="PluginOpenButton" Content="{x:Static res:Strings.Settings_PluginImport}" Click="OnPluginOpenClick"
                  Margin="8,0,0,0" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="PluginStatusText" Foreground="{StaticResource Quiet}" FontSize="12"
                   Margin="0,12,0,0" />

        <TextBlock Margin="0,16,0,0" FontSize="12">
          <Hyperlink Click="OnReleasesClick" Foreground="#FF4C9AFF">
            <Run Text="{x:Static res:Strings.Settings_OpenReleasePage}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
