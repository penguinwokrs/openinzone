<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenInzone.Tray.FlyoutWindow"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="320">
  <Border Background="#FF202225" CornerRadius="8" Padding="16" BorderBrush="#FF3A3D42" BorderThickness="1">
    <Border.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFE8EAED" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent"><ContentPresenter /></Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Border.Resources>

    <StackPanel>
      <TextBlock x:Name="ModelText" Text="未接続" FontSize="13" Margin="0,0,0,12" Opacity="0.7" />

      <Grid x:Name="VolumeRow" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <Button x:Name="VolumeMuteButton" Style="{StaticResource IconButton}" ToolTip="音量ミュート">
          <Grid>
            <Path Data="{StaticResource SpeakerGeometry}" Stroke="#FFE8EAED" StrokeThickness="1.6" Fill="#FFE8EAED" />
            <Path x:Name="VolumeMutedSlash" Data="{StaticResource MutedSlashGeometry}"
                  Stroke="#FFE06C75" StrokeThickness="2" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="30" Margin="10,0"
                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="--" HorizontalAlignment="Right" />
      </Grid>

      <Grid x:Name="MicRow" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <Button x:Name="MicMuteButton" Style="{StaticResource IconButton}" ToolTip="マイクミュート">
          <Grid>
            <Path Data="{StaticResource MicGeometry}" Stroke="#FFE8EAED" StrokeThickness="1.6" />
            <Path x:Name="MicMutedSlash" Data="{StaticResource MutedSlashGeometry}"
                  Stroke="#FFE06C75" StrokeThickness="2" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Slider x:Name="MicSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="10,0"
                VerticalAlignment="Center" />
        <TextBlock x:Name="MicText" Grid.Column="2" Text="--" HorizontalAlignment="Right" />
      </Grid>

      <Grid x:Name="BalanceRow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <Path Data="{StaticResource BalanceGeometry}" Stroke="#FFE8EAED" StrokeThickness="1.6"
              Width="28" Height="28" Stretch="Uniform" ToolTip="ゲーム / チャット" />
        <Slider x:Name="BalanceSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="10,0"
                IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" />
        <TextBlock x:Name="BalanceText" Grid.Column="2" Text="--" HorizontalAlignment="Right" />
      </Grid>

      <Separator Margin="0,14,0,10" Background="#FF3A3D42" />

      <StackPanel Orientation="Horizontal">
        <Path Data="{StaticResource BatteryGeometry}" Stroke="#FFE8EAED" StrokeThickness="1.6"
              Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" />
        <TextBlock x:Name="BatteryText" Text="--" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
