<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon has no WPF equivalent; it is the only thing WinForms is used for. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenInzone.Tray</RootNamespace>
    <AssemblyName>inzonetray</AssemblyName>
    <ApplicationIcon>..\..\assets\openinzone.ico</ApplicationIcon>
    <Copyright>Copyright (C) 2026 penguinwokrs</Copyright>
    <Product>OpenInzone</Product>
    <!-- FileDescription - what Task Manager's Startup tab shows - falls back to AssemblyName
         (inzonetray) without this, which is why it showed the wrong thing there. -->
    <AssemblyTitle>OpenInzone</AssemblyTitle>
    <Company>penguinwokrs</Company>
    <Description>Tray application for controlling Sony INZONE headsets</Description>
    <!-- A local build with no -p:Version would otherwise report 1.0.0.0 and believe itself newer
         than every real release. The release workflow's -p:Version overrides this. -->
    <Version>0.1.0</Version>
    <!-- Required to build a desktop application from a non-Windows host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenInzone.Control\OpenInzone.Control.csproj" />
    <ProjectReference Include="..\OpenInzone.Ipc\OpenInzone.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\openinzone.ico" Link="openinzone.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same in-box MSBuild generator Task 2 wired into OpenInzone.Control, for the same reason:
         it runs on a plain `dotnet build`, so the WSL-published release gets the class too. -->
    <EmbeddedResource Update="Resources\Strings.resx"
                      StronglyTypedClassName="Strings"
                      StronglyTypedNamespace="OpenInzone.Tray.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs"
                      StronglyTypedLanguage="CSharp"
                      PublicClass="true"
                      Generator="" />
  </ItemGroup>
</Project>
