<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The source-generated interop for CreateProcess is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenInzone.Ipc</RootNamespace>
    <AssemblyName>OpenInzone.Ipc</AssemblyName>
    <Copyright>Copyright (C) 2026 penguinwokrs</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

    <!--
      The Stream Deck plugin publishes trimmed, so this assembly must carry no reflection-based
      serialisation: every payload goes through the source-generated context in IpcJson.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The search order is worth exercising without an installed copy to find. -->
    <InternalsVisibleTo Include="OpenInzone.Core.Tests" />
  </ItemGroup>
</Project>
